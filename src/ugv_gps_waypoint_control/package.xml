<?xml version="1.0"?>
<package format="3">
  <name>ugv_gps_waypoint_control</name>
  <version>0.1.0</version>
  <description>
    GPS-only ordered global waypoint control for the independent Subject 2 test workspace.
  </description>
  <maintainer email="xcxc@nuaa.com">xcc</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ugv_subject2_mvp</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ugv_localization_mvp</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
